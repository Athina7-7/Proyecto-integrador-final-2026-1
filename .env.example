# Dominio usado en AWS. En laboratorio puede dejarse en localhost.
DOMAIN_NAME=localhost
PUBLIC_URL=https://localhost

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=telematica
DB_USER=telematica_user
DB_PASSWORD=change_me_in_production

# Flask/Gunicorn
FLASK_ENV=production

# SMTP para envio de estadisticas.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=correo@gmail.com, SMTP_PASSWORD=app_password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=ialondonoo@eafit.edu.co

# Seguridad basica del panel de estadisticas.
# En una entrega real cambie este valor y documente quien lo conoce.
ADMIN_TOKEN=change_this_admin_token
